{
  "openapi": "3.0.3",
  "info": {
    "title": "Secure Server API",
    "version": "1.0.0",
    "description": "Definición para pentesters y escáneres (ZAP, Burp). Se valida contra el código en test_api.js: si se añade una ruta sin documentarla, la prueba falla."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Estado del proceso (no usa la BD)",
        "tags": [
          "Sistema"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sin sesión válida"
          },
          "429": {
            "description": "Límite de peticiones"
          }
        },
        "security": []
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Registro",
        "tags": [
          "Autenticación"
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "Creado"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "409": {
            "description": "El usuario ya existe"
          },
          "429": {
            "description": "Límite"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "email",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  },
                  "deviceInfo": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login (paso 1). Con MFA devuelve mfaRequired y mfaToken",
        "tags": [
          "Autenticación"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Token de sesión, o reto de MFA"
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "429": {
            "description": "Cuenta bloqueada (ACCOUNT_LOCKED) o límite"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "deviceInfo": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/auth/login/mfa": {
      "post": {
        "summary": "Login (paso 2): segundo factor",
        "tags": [
          "Autenticación"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Token de sesión"
          },
          "401": {
            "description": "Código o reto inválido"
          },
          "429": {
            "description": "Bloqueado"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mfaToken"
                ],
                "properties": {
                  "mfaToken": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  },
                  "recoveryCode": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Cierra la sesión",
        "tags": [
          "Autenticación"
        ],
        "parameters": [],
