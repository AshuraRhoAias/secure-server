# ====================
# SERVER & APP CONFIG
# ====================
PORT=3000
NODE_ENV=development

# ====================
# FRAGMENTOS DE DATABASE (Dividir URL en partes)
# ====================
DB_FRAGMENT_1=mysql://root:@
DB_FRAGMENT_2=localhost:
DB_FRAGMENT_3=3306/secure_platform

# ====================
# SEMILLAS PARA GENERACIÓN DINÁMICA
# ====================
BASE_SEED=9a1f3b8e2d4c7f1a9b2d3e4f5678123456789abcdef1234567890abcdef123456
JWT_SEED=e2f1c3a9b4d5f6789abc1234567890abcdef1234567890abcdef1234567890ab
ENCRYPTION_SEED=7c9e1a2b3d4f567890abcdef1234567890abcdef1234567890abcdef12345678
EMAIL_SEED=b8f1234567890abcdef1234567890abcdef1234567890abcdef1234567890abc

# ====================
# FRAGMENTOS DE EMAIL (Dividir credenciales)
# ====================
DISABLE_EMAIL_NOTIFICATIONS=false
PRIMARY_EMAIL_USER=mendezperezraul580
EMAIL_DOMAIN_1=gmail.com
PRIMARY_EMAIL_PASSWORD=War034272@
BACKUP_EMAIL_USER=tu_usuario_backup
EMAIL_DOMAIN_2=gmail.com
RECIPIENT_EMAIL=mendezperezraul580@gmail.com

# ====================
# TELEGRAM (OPCIONAL - Canal de emergencia)
# ====================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ====================
# CONFIGURACIÓN DE SEGURIDAD
# ====================
INTEGRITY_MONITOR_ENABLED=true
INTEGRITY_CHECK_INTERVAL_MIN=60
AUTO_ROTATION_ENABLED=true
ANOMALY_DETECTION_ENABLED=true
AUTO_BLOCK_MALICIOUS_IPS=true

# ====================
# CONFIGURACIÓN DE ALERTAS
# ====================
ALERT_CHANNELS=email,telegram
CAMOUFLAGE_ENABLED=true
MULTI_CHANNEL_CRITICAL=true

# ====================
# CONFIGURACIÓN DE RIESGO
# ====================
MAX_FAILED_ATTEMPTS=5
SESSION_RISK_THRESHOLD=50
DEVICE_TRUST_REQUIRED=true
GEO_ANOMALY_DETECTION=true
# ====================
# CLAVES DE CIFRADO (rotación)
# ====================
# KEY_EPOCH activa las claves ESTABLES (no cambian hasta rotar). Sin ella el sistema usa el modo
# legacy, cuyas claves cambian cada día. Lo gestiona `npm run rotate-keys`: no cambies estas tres
# variables a mano en un sistema con datos, o quedarán ilegibles. ENCRYPTION_SEED y JWT_SEED están
# más arriba. Para estrenar un sistema vacío en modo estable basta con definir KEY_EPOCH:
KEY_EPOCH=E_inicial
# BACKUP_RETENTION=12     # (opcional) backups a conservar con la rotación automática; 0 = todos
# ROTATION_DATA_DIR=      # (opcional) por defecto ./data/rotation
# BACKUP_DIR=             # (opcional) por defecto ./backups

# =============================================================
# SEGURIDAD EN TABLAS, ARCHIVOS Y CIFRADO v4 (ver docs/SEGURIDAD.md)
# Todo es opcional: los valores de abajo son los POR DEFECTO.
# =============================================================

# Proxy inverso delante (nginx, balanceador): cuántos saltos hay. Sin esto, todas las peticiones
# parecen venir de la IP del proxy y los límites/bloqueos afectan a todos los usuarios.
# TRUST_PROXY=1
# IPs que nunca se bloquean automáticamente (separadas por comas). El loopback ya está exento.
# PROTECTION_ALLOWLIST=

# Base de datos por TLS: verify (producción) | no-verify | off (fuera de producción)
# DB_SSL=verify
# DB_SSL_CA=/ruta/a/ca.pem
# DB_POOL_SIZE=10
# DB_QUEUE_LIMIT=500

# Límites de peticiones (estado en MySQL, compartido entre procesos)
# RATE_LIMIT_GLOBAL_PER_MIN=600
# SENSITIVE_RATE_LIMIT_PER_MIN=10
# INJECTION_STRIKES_TO_BLOCK=5
# INJECTION_BODY_MODE=block        # block | log (log: las firmas en el CUERPO solo se registran)
# SCANNER_HITS_TO_BLOCK=5
# AUTH_FAILURES_TO_BLOCK=30
# MAX_FAILED_ATTEMPTS=5
# LOCKOUT_WINDOW_SECONDS=900
# LOGIN_IP_FAILURES_TO_BLOCK=20
# SESSION_TTL_HOURS=120
# SECURITY_EVENTS_RETENTION_DAYS=90
# SECURITY_EVENTS_MAX_PER_MINUTE=30
# JSON_BODY_LIMIT=1mb

# Archivos (API /api/files). FILES_DIR debe estar FUERA de cualquier carpeta servida por un servidor web.
# FILES_DIR=./storage
# UPLOAD_MAX_IMAGE_MB=25
# UPLOAD_MAX_AUDIO_MB=100
# UPLOAD_MAX_VIDEO_MB=512
# UPLOAD_MAX_DOCUMENT_MB=50
# UPLOAD_MAX_TEXT_MB=5
# UPLOAD_USER_QUOTA_MB=1024
# UPLOAD_MAX_FILES_PER_USER=5000
# UPLOAD_RATE_PER_MIN=20
# DOWNLOAD_RATE_PER_MIN=600
# REQUEST_TIMEOUT_MS=600000

# --- Bloqueo de cuenta (por usuario + origen; ver docs/SEGURIDAD.md §3) ---
# LOCKOUT_GLOBAL_FAILURES=20       # fallos totales por usuario (todos los orígenes) antes de bloquear orígenes desconocidos
# TRUSTED_SOURCE_DAYS=30           # un origen con login correcto en estos días no sufre el bloqueo global

# --- MFA (TOTP) ---
# MFA_ISSUER=Secure Platform
# MFA_REQUIRED_FOR_ADMINS=false    # true: los administradores necesitan segundo factor (o SSO)

# --- SSO (OpenID Connect). Sin SSO_ISSUER/SSO_CLIENT_ID/SSO_REDIRECT_URI queda desactivado ---
# SSO_ISSUER=https://login.ejemplo.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://api.ejemplo.com/api/sso/callback
# SSO_SCOPES=openid email profile
# SSO_ALLOWED_EMAIL_DOMAINS=ejemplo.com
# SSO_AUTO_PROVISION=true
# SSO_REQUIRE_EMAIL_VERIFIED=true
# SSO_ADMIN_CLAIM=groups
# SSO_ADMIN_VALUE=secure-server-admins
# SSO_POST_LOGIN_URL=https://app.ejemplo.com/auth/callback

# --- KMS: envolver semillas/secretos (valores "kms:<proveedor>:<blob>"; ver npm run kms) ---
# KMS_PROVIDER=file                # file | vault | aws
# KMS_KEK_FILE=/run/secrets/kek    # permisos 0400, fuera del repositorio
# KMS_KEY_ID=                      # aws: id/alias de la clave KMS
# KMS_ENDPOINT=
# VAULT_ADDR=https://vault.ejemplo.com:8200
# VAULT_TOKEN_FILE=/run/secrets/vault-token
# VAULT_TRANSIT_KEY=secure-server
# KMS_DATA_KEYS=false              # true: la clave de CADA archivo se envuelve con el KMS (kms1:); luego `npm run kms -- migrate-files`
# KMS_DATA_KEY_CACHE_SECONDS=300   # caché en memoria de claves de archivo (0 = sin caché)
# KMS_TIMEOUT_MS=30000

# --- Antivirus (ClamAV clamd) ---
# FILE_SCAN=off                    # off | optional | required (recomendado en producción)
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_SOCKET=
# CLAMAV_TIMEOUT_MS=60000
# CLAMAV_MAX_BYTES=26214400        # igual que StreamMaxLength de clamd
# FILE_SCAN_ON_OVERSIZE=reject     # reject | skip

# --- Copias de FILES_DIR (npm run files:backup) ---
# FILES_BACKUP_DIR=/mnt/copias/archivos
# FILES_BACKUP_RETENTION_DAYS=30

# --- Sesiones: JWT corto + refresh token con rotación (docs/SEGURIDAD.md §15) ---
# ACCESS_TOKEN_MINUTES=15          # vida del JWT de acceso
# REFRESH_IDLE_DAYS=7              # inactividad máxima (se desliza con cada renovación)
# SESSION_ABSOLUTE_DAYS=30         # tope: pasado este tiempo hay que iniciar sesión de nuevo
# REFRESH_REUSE_GRACE_SECONDS=10   # dos pestañas que renuevan a la vez no son un robo (409)

# --- Aprobación de dos administradores (§16) ---
# ADMIN_APPROVALS_REQUIRED=2       # 1 = sin segunda firma (solo con UN administrador)
# ADMIN_APPROVAL_TTL_HOURS=24

# --- Passkeys / WebAuthn (§17): sin RP_ID y ORIGINS quedan desactivadas ---
# WEBAUTHN_RP_ID=app.ejemplo.com   # dominio, sin esquema ni puerto
# WEBAUTHN_ORIGINS=https://app.ejemplo.com
# WEBAUTHN_RP_NAME=Mi aplicación
# WEBAUTHN_USER_VERIFICATION=preferred   # required | preferred | discouraged

# --- SAML 2.0 (§17) ---
# SAML_IDP_SSO_URL=https://idp.ejemplo.com/sso
# SAML_IDP_ENTITY_ID=https://idp.ejemplo.com/metadata
# SAML_IDP_CERT=/run/secrets/idp-cert.pem   # PEM o rutas separadas por comas (varias para rotar)
# SAML_CALLBACK_URL=https://api.ejemplo.com/api/saml/acs
# SAML_SP_ENTITY_ID=
# SAML_REQUIRE_SIGNED=assertion    # assertion | response | both
# SAML_EMAIL_ATTRIBUTE=email
# SAML_ALLOWED_EMAIL_DOMAINS=ejemplo.com
# SAML_AUTO_PROVISION=true
# SAML_ADMIN_ATTRIBUTE=groups
# SAML_ADMIN_VALUE=secure-server-admins
# SAML_CLOCK_SKEW_SECONDS=60
# SAML_FORCE_AUTHN=false
# SAML_POST_LOGIN_URL=https://app.ejemplo.com/auth/callback
# SAML_SP_PRIVATE_KEY=             # opcional: firmar nuestras solicitudes
# SAML_SP_CERT=

# --- Archivos: saneado de imágenes y PDF (§18) ---
# IMAGE_SANITIZE=on                # recodifica JPEG/PNG/GIF/WebP: sin EXIF, GPS ni datos ocultos
# IMAGE_JPEG_QUALITY=90
# IMAGE_MAX_PIXELS=100000000
# IMAGE_SANITIZE_PASSTHROUGH=      # tipos sin saneador que se aceptan tal cual (p. ej. heic)
# PDF_ACTIVE_CONTENT=reject        # reject | allow
# PDF_MAX_INFLATED_MB=64
# SANITIZE_MAX_CONCURRENT=4
# INJECTION_BODY_MODE=critical     # critical | block | log
# INJECTION_BLOCK_PATHS=/api/auth,/api/system,/api/sso

# --- Operación y observabilidad, SOLO admin (§19) ---
# ALERTS_DISABLED=false
# ALERT_EVAL_INTERVAL_SECONDS=60
# ALERT_WINDOW_MINUTES=10
# ALERT_LOGIN_FAILURES=50
# ALERT_LOGIN_FAILURE_IPS=10
# ALERT_ACCOUNT_FAILURES=15
# ALERT_MFA_FAILURES=10
# ALERT_INJECTION_ATTEMPTS=20
# ALERT_IP_BLOCKS=10
# ALERT_AUTO_RESOLVE_MINUTES=60
# ALERT_WEBHOOK_URL=https://hooks.ejemplo.com/seguridad
# ALERT_WEBHOOK_SECRET=            # firma HMAC-SHA256 en la cabecera X-Signature-256
# ALERT_NOTIFY_MIN_SEVERITY=high   # low | medium | high | critical
# METRICS_TOKEN=                   # >= 32 caracteres: permite a Prometheus leer SOLO /api/metrics
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.ejemplo.com:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_SERVICE_NAME=secure-server
# HOUSEKEEPING_INTERVAL_MINUTES=10

# --- Solo desarrollo y pruebas (NUNCA en producción) ---
# `npm run dev` (nodemon) se niega con NODE_ENV=production; en producción: npm ci --omit=dev && npm start
# FUZZ_RUNS=100                    # iteraciones por propiedad del fuzzing (npm run test:fuzz)
# FUZZ_SEED=                       # repite una ejecución fallida
