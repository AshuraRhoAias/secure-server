{
  "name": "secure-server",
  "version": "1.0.0",
  "description": "Sistema ultra seguro con cifrado multicapa y seguridad operacional avanzada",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:cluster": "node src/cluster.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web start",
    "dev": "node scripts/devGuard.js",
    "db:tls": "node scripts/dbTlsCerts.js",
    "test": "node test/test_system.js",
    "test:api": "node --test test/test_api.js",
    "test:db": "node --test test/test_db.js",
    "test:icmp": "node --test test/test_icmp.js",
    "ops:test-runner": "node scripts/ops-test-runner.js",
    "icmp-monitor": "node scripts/icmpMonitor.js",
    "icmp-firewall": "bash scripts/icmp-firewall.sh",
    "set-role": "node scripts/setUserRole.js",
    "debug-env": "node scripts/debug-env.js",
    "fix-permissions": "chmod 600 .env || echo 'Permisos ajustados'",
    "decrypt-message": "node scripts/decryptMessage.js",
    "emergency-backup": "node scripts/emergencyRecovery.js backup",
    "emergency-restore": "node scripts/emergencyRecovery.js restore",
    "rotate-keys": "node scripts/rotateKeys.js",
    "maintenance-firewall": "bash scripts/maintenance-firewall.sh",
    "test:rotation": "node --test test/test_rotation.js",
    "check-system": "node -e \"require('./src/middleware/serverCheck.middleware').performAsyncCheck()\"",
    "security-audit": "node scripts/securityAudit.js",
    "health-check": "node scripts/healthCheck.js",
    "test:security": "node --test test/test_security.js",
    "test:files": "node --test test/test_files.js",
    "test:all": "node --test --test-concurrency=1 test/test_api.js test/test_db.js test/test_icmp.js test/test_rotation.js test/test_security.js test/test_mfa.js test/test_sessions.js test/test_rbac.js test/test_users_admin.js test/test_settings.js test/test_runs.js test/test_webauthn.js test/test_sso.js test/test_saml.js test/test_kms.js test/test_kms_files.js test/test_files.js test/test_sanitize.js test/test_ops.js test/test_scale.js test/test_av.js test/test_files_backup.js test/test_s3.js test/test_files_s3.js test/test_partitions.js test/test_fuzz.js",
    "test:mfa": "node --test test/test_mfa.js",
    "test:sessions": "node --test test/test_sessions.js",
    "test:runs": "node --test test/test_runs.js",
    "test:rbac": "node --test test/test_rbac.js",
    "test:sanitize": "node --test test/test_sanitize.js",
    "test:ops": "node --test test/test_ops.js",
    "test:webauthn": "node --test test/test_webauthn.js",
    "test:saml": "node --test test/test_saml.js",
    "test:sso": "node --test test/test_sso.js",
    "kms": "node scripts/kms.js",
    "test:kms": "node --test test/test_kms.js",
    "test:kms-files": "node --test test/test_kms_files.js",
    "test:av": "node --test test/test_av.js",
    "rescan-files": "node scripts/rescanFiles.js",
    "files:backup": "node scripts/filesBackup.js backup",
    "files:verify": "node scripts/filesBackup.js verify",
    "files:restore": "node scripts/filesBackup.js restore",
    "test:files-backup": "node --test test/test_files_backup.js",
    "lint:security": "eslint src scripts --max-warnings 0",
    "check:prod-deps": "node scripts/checkProductionDeps.js",
    "test:fuzz": "node --test test/test_fuzz.js",
    "coverage": "c8 --reporter=text-summary --reporter=lcov --reporter=json-summary npm run test:all",
    "coverage:check": "c8 check-coverage",
    "bench:scale": "node benchmarks/scale-bench.js",
    "test:scale": "node --test test/test_scale.js",
    "test:s3": "node --test test/test_s3.js",
    "test:files-s3": "node --test test/test_files_s3.js",
    "test:compose": "node --test test/test_compose.js",
    "events:partition": "node scripts/eventsPartitions.js",
    "test:partitions": "node --test test/test_partitions.js",
    "docs:endpoints": "node scripts/openapiTable.js"
  },
  "keywords": [
    "security",
    "encryption",
    "authentication",
    "server",
    "nodejs"
  ],
  "author": "Security Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1165.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@node-saml/node-saml": "^5.2.0",
    "@prometheus-io/client": "^0.16.1",
    "@simplewebauthn/server": "^14.0.3",
    "@xmldom/xmldom": "^0.8.15",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "device-detector-js": "^3.0.3",
    "dotenv": "^17.2.1",
    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.1.0",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "speakeasy": "^2.0.0",
    "ua-parser-js": "^2.0.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "xml-crypto": "^6.4.0"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    }
  }
}
