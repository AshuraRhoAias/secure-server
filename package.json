{
  "name": "secure-server",
  "version": "1.0.0",
  "description": "Sistema ultra seguro con cifrado multicapa y seguridad operacional avanzada",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node test_system.js",
    "test:api": "node --test test_api.js",
    "test:icmp": "node --test test_icmp.js",
    "icmp-monitor": "node scripts/icmpMonitor.js",
    "icmp-firewall": "bash scripts/icmp-firewall.sh",
    "set-role": "node scripts/setUserRole.js",
    "debug-env": "node debug-env.js",
    "fix-permissions": "chmod 600 .env || echo 'Permisos ajustados'",
    "decrypt-message": "node scripts/decryptMessage.js",
    "emergency-backup": "node scripts/emergencyRecovery.js backup",
    "emergency-restore": "node scripts/emergencyRecovery.js restore",
    "rotate-keys": "node scripts/rotateKeys.js",
    "maintenance-firewall": "bash scripts/maintenance-firewall.sh",
    "test:rotation": "node --test test_rotation.js",
    "check-system": "node -e \"require('./src/middleware/serverCheck.middleware').performAsyncCheck()\"",
    "security-audit": "node scripts/securityAudit.js",
    "health-check": "node -e \"console.log('Sistema funcionando'); process.exit(0)\"",
    "test:security": "node --test test_security.js",
    "test:files": "node --test test_files.js",
    "test:all": "node --test --test-concurrency=1 test_api.js test_icmp.js test_rotation.js test_security.js test_mfa.js test_sessions.js test_rbac.js test_sso.js test_kms.js test_files.js test_av.js test_files_backup.js",
    "test:mfa": "node --test test_mfa.js",
    "test:sessions": "node --test test_sessions.js",
    "test:rbac": "node --test test_rbac.js",
    "test:sso": "node --test test_sso.js",
    "kms": "node scripts/kms.js",
    "test:kms": "node --test test_kms.js",
    "test:av": "node --test test_av.js",
    "rescan-files": "node scripts/rescanFiles.js",
    "files:backup": "node scripts/filesBackup.js backup",
    "files:verify": "node scripts/filesBackup.js verify",
    "files:restore": "node scripts/filesBackup.js restore",
    "test:files-backup": "node --test test_files_backup.js",
    "lint:security": "eslint src scripts --max-warnings 0"
  },
  "keywords": [
    "security",
    "encryption",
    "authentication",
    "server",
    "nodejs"
  ],
  "author": "Security Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1155.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "device-detector-js": "^3.0.3",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "fs-extra": "^11.3.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.1.0",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "ua-parser-js": "^2.0.4",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.13.0",
    "nodemon": "^3.1.10"
  }
}
