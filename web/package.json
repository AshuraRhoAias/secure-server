{
  "name": "secure-server-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Interfaz web de operación y observabilidad (solo administradores) de secure-server. Next.js + React con un BFF que guarda los tokens en una cookie httpOnly cifrada.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test --test-concurrency=1 e2e/ops.test.cjs e2e/live-auth.test.cjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
