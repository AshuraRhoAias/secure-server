# Interfaz web de operación (web/). Ver web/README.md y docs/SEGURIDAD.md §24.
OPS_API_URL=https://api.ejemplo.com          # obligatoria; https en producción
# OPS_API_ALLOW_HTTP=false                    # true solo en redes internas de confianza
WEB_SESSION_SECRET=                           # obligatoria: >= 32 caracteres aleatorios (openssl rand -base64 48)
# WEB_SESSION_SECRET_PREVIOUS=                # para rotar el secreto sin cerrar sesiones
# WEB_ORIGIN=https://ops.ejemplo.com          # recomendada si un proxy reescribe el Host
# WEB_COOKIE_SECURE=true                      # por defecto true en producción
# WEB_TRUST_PROXY_HOPS=1                      # proxies de confianza delante; 0 = expuesta directamente
# OPS_API_TIMEOUT_MS=10000
# NEXT_TELEMETRY_DISABLED=1
